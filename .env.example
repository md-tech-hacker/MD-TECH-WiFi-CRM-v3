# MD TECH Wi-Fi CRM Configuration Template
# Copy to .env and adjust values as needed

# Host binding: Use 127.0.0.1 for local administration, or 0.0.0.0 for LAN/Docker exposure
MDTECH_HOST=127.0.0.1
MDTECH_PORT=8765

# Optional: Gateway API shared secret key (generated in CRM Settings -> Gateway Key)
# MDTECH_GATEWAY_KEY=your_secure_gateway_api_key_here

# Optional: MikroTik / OpenWrt / Gateway adapter settings
# MIKROTIK_HOST=192.168.88.1
# MIKROTIK_USER=admin
# MIKROTIK_PASS=your_mikrotik_password
